{
  "expo": {
    "name": "Paisa Pulse",
    "slug": "paisa-pulse",
    "scheme": "paisapulse",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "bundleIdentifier": "com.paisapulse.app",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.paisapulse.app"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#5E5CE6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.paisapulse.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Paisa Pulse uses Face ID to keep your finances private."
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "@bacons/apple-targets",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Spending",
              "label": "Month Spend",
              "description": "What you have spent this month, your budget and a quick Add button.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "400dp",
              "maxResizeHeight": "250dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-quick-actions",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Midnight",
            "ios": "./assets/icons/midnight.png",
            "android": {
              "foregroundImage": "./assets/icons/fg-accent.png",
              "backgroundColor": "#000000"
            }
          },
          {
            "name": "Saffron",
            "ios": "./assets/icons/saffron.png",
            "android": {
              "foregroundImage": "./assets/icons/fg-white.png",
              "backgroundColor": "#FF8A1F"
            }
          },
          {
            "name": "Mint",
            "ios": "./assets/icons/mint.png",
            "android": {
              "foregroundImage": "./assets/icons/fg-white.png",
              "backgroundColor": "#3CC7BC"
            }
          },
          {
            "name": "Mono",
            "ios": "./assets/icons/mono.png",
            "android": {
              "foregroundImage": "./assets/icons/fg-black.png",
              "backgroundColor": "#FFFFFF"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
